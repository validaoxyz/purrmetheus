name: purrmetheus

networks:
  purrmetheus:
    driver: bridge

services:
  hl_exporter:
    build:
      context: ..
      dockerfile: docker/Dockerfile
      args:
        USER_ID: ${USER_ID}
        GROUP_ID: ${GROUP_ID}
        EXPORTER_VERSION: ${EXPORTER_VERSION}
    image: purrmetheus/hl_exporter:${EXPORTER_VERSION}
    container_name: hl_exporter
    # Host-node mode injects host PID visibility; the reduced Dockerized-node
    # profile leaves the exporter in its own namespace.
${EXPORTER_PID_BLOCK}
${EXPORTER_EXTRA_HOSTS}
    environment:
      NODE_HOME: /home/hluser/hl
      BINARY_HOME: /home/hluser/bin
      NODE_BINARY: ${COMPOSE_CONTAINER_NODE_BINARY}
    command: ${EXPORTER_CMD}
    volumes:
${VOLUME_MOUNTS}
${NODE_BINARY_MOUNT}
${CRIT_LOCATIONS_MOUNT}
${EXPORTER_NETWORK_BLOCK}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8086/livez"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

  prometheus:
    image: prom/prometheus:v3.0.1@sha256:565ee86501224ebbb98fc10b332fa54440b100469924003359edf49cbce374bd
    container_name: prometheus
    hostname: prometheus
${PROMETHEUS_EXTRA_HOSTS}
    volumes:
      - prometheus_data:/prometheus
      - ../prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ../prometheus/alerts.yml:/etc/prometheus/alerts.yml:ro
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=${PROMETHEUS_RETENTION}'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'
      - '--web.listen-address=:9090'
      - '--web.enable-lifecycle'
    networks:
      - purrmetheus
    restart: unless-stopped
    depends_on:
      hl_exporter:
        condition: service_started
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:9090/-/ready >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  grafana:
    image: grafana/grafana:11.4.0@sha256:d8ea37798ccc41061a62ab080f2676dda6bf7815558499f901bdb0f533a456fb
    container_name: grafana
    hostname: grafana
    environment:
      GF_SECURITY_ADMIN_USER: ${COMPOSE_GRAFANA_ADMIN_USER}
      GF_SECURITY_ADMIN_PASSWORD: ${COMPOSE_GRAFANA_ADMIN_PASSWORD}
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_INSTALL_PLUGINS: ""
    volumes:
      - grafana_data:/var/lib/grafana
      - ../grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
      - ../grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ../grafana/dashboards:/var/lib/grafana/dashboards:ro
    ports:
      - '${GRAFANA_PORT}:3000'
    networks:
      - purrmetheus
    restart: unless-stopped
    depends_on:
      prometheus:
        condition: service_started
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:3000/api/health >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  node_exporter:
    image: prom/node-exporter:v1.8.2@sha256:4032c6d5bfd752342c3e631c2f1de93ba6b86c41db6b167b9a35372c139e7706
    container_name: node_exporter
    hostname: node_exporter
    command:
      - '--path.procfs=/host/proc'
      - '--path.sysfs=/host/sys'
      - '--path.rootfs=/host/root'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc|rootfs/var/lib/docker/containers|rootfs/var/lib/docker/overlay2|rootfs/run/docker/netns|rootfs/var/lib/docker/aufs)($$|/)'
      - '--collector.filesystem.fs-types-exclude=^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$$'
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      # Read-only root visibility is portable across Linux and Docker Desktop.
      # Docker Desktop rejects rslave propagation because its host root mount
      # is not marked shared; propagation is optional for node_exporter's
      # filesystem collector.
      - /:/host/root:ro
    pid: host
    networks:
      - purrmetheus
    restart: unless-stopped

volumes:
  prometheus_data:
  grafana_data:
${EXTRA_VOLUMES}
