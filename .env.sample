# =============================================================================
# Purrmetheus configuration
# =============================================================================
# Copy this file to `.env` and edit values to match your setup.
# After editing, run `bash generate_config.sh` from the repo root, then
# `docker compose -f docker/docker-compose.yaml up -d`.
# =============================================================================

# --- Node setup -------------------------------------------------------------

# Set to 'true' if your Hyperliquid node is running inside Docker (uses the
# external `hyperliquid_hl-data` volume at its /home/hluser/hl/data path).
# This reduced profile exposes persisted data metrics; root-level node state
# and binaries are not in that volume, so version/update checks are skipped.
# Host-node mode uses host PID + network namespaces so Linux procfs, TCP, and
# the default --serve-info probe can see the node. Docker Desktop 4.34+ must
# have host networking enabled, and the node must be in the same Linux VM.
USE_DOCKER=false

# Absolute path to the node's data directory on the host (used when
# USE_DOCKER=false). Default if left empty: $HOME/hl (e.g. /home/ubuntu/hl).
NODE_HOME=

# Absolute path to the node binary on the host (used when USE_DOCKER=false).
# Default if left empty: $HOME/hl-node. It must be an executable regular file;
# resolve symlinks before setting this value.
# The containing directory is bind-mounted into the exporter. Keep both
# hl-node and hl-visor in that directory when version/update checks are enabled,
# or set BINARY_HOME below when hl-visor lives elsewhere.
NODE_BINARY=

# Optional directory containing hl-visor for the v4 update check. If empty,
# generate_config.sh uses the resolved NODE_BINARY directory. When this differs
# from that directory, both directories are mounted read-only in the exporter.
BINARY_HOME=

# Optional URL for --probe-info-endpoint. Leave empty to use the exporter
# default http://127.0.0.1:3001/info only when the node exposes --serve-info
# there. In Dockerized-node mode, set this to the explicitly published
# --serve-info URL reachable from the exporter. An EVM RPC URL (often port
# 3001 with an /evm path) is not an info-probe endpoint.
INFO_ENDPOINT_URL=

# Host directory containing the v4 matched visor projection
# /tmp/crit_msg_latest_stats/hl-visor.json. It is mounted read-only at the
# fixed path expected by the exporter. Dockerized-node mode needs the node
# deployment to share this directory; otherwise the optional source stays
# unavailable and is reported through hl_exporter_source_*.
# Leave empty to disable the mount explicitly.
# The exporter reads this source only when --extended-metrics is enabled.
CRIT_LOCATIONS_DIR=/tmp/crit_msg_latest_stats

# Network. Allowed: mainnet, testnet (case-insensitive; surrounding whitespace
# is trimmed).
CHAIN=mainnet

# Free-form label used as the `node` external label in Prometheus.
# Helpful for filtering across multiple machines if you later federate.
NODE_LABEL=hl-node

# --- Exporter version + flags ----------------------------------------------

# hyperliquid-exporter release to pull from GitHub. v4.0.7 is the current
# tested release. Pin a tag for reproducible builds, or set to 'latest' to
# follow the newest GitHub release.
EXPORTER_VERSION=v4.0.7

# Extra flags passed to `hl_exporter start`. Use whitespace-delimited
# `--flag` or `--flag=value` tokens; value-bearing flags must use `=`, and
# positional tokens are rejected. Dockerized-node mode adds
# --skip-version-check and --skip-update-check because the node binaries live
# outside the exporter image. Host-node mode leaves both checks enabled.
#
# Useful flags:
#   --replica-metrics          tx/order metrics (needs node --replica-cmds-style)
#   --evm-metrics              HyperEVM block, gas and transaction metrics
#   --contract-metrics         capped recipient-address diagnostics
#   --extended-metrics         RocksDB, lz4, tokio, public-IP, logs, etc.
#   --probe-info-endpoint      active probe of node's --serve-info
#   --per-peer-metrics         current explicit child identities (max 16)
EXPORTER_EXTRA_FLAGS="--evm-metrics"

# --- Grafana / Prometheus ---------------------------------------------------

# Grafana login (you'll be prompted to rotate the password on first login).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Host port for the Grafana UI. Change if 3000 is already taken.
GRAFANA_PORT=3000

# Prometheus on-disk retention. Examples: 15d, 30d, 90d.
PROMETHEUS_RETENTION=30d
