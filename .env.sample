# =============================================================================
# Purrmetheus configuration
# =============================================================================
# Copy this file to `.env` and edit values to match your setup.
# After editing, run `bash generate_config.sh` from the repo root, then
# `docker compose -f docker/docker-compose.yaml up -d`.
# =============================================================================

# --- Node setup -------------------------------------------------------------

# Set to 'true' if your Hyperliquid node is running inside Docker (uses the
# external `hyperliquid_hl-data` volume). 'false' for a host-installed node.
USE_DOCKER=false

# Path to the node's data directory on the host (used when USE_DOCKER=false).
# Default if left empty: $HOME/hl  (e.g. /home/ubuntu/hl)
NODE_HOME=

# Path to the visor/node binary on the host (used when USE_DOCKER=false).
# Default if left empty: $HOME/hl-visor
# The directory containing the binary is bind-mounted, so hl-node should sit
# next to hl-visor (this matches the standard validator install layout).
NODE_BINARY=

# --- Validator metadata -----------------------------------------------------

# Set to 'true' if this node is a validator (enables validator-only panels).
IS_VALIDATOR=false

# Your validator address (used for dashboard filtering/highlighting).
VALIDATOR_ADDRESS=

# Network. Allowed: mainnet, testnet.
CHAIN=mainnet

# Free-form label used as the `node` external label in Prometheus.
# Helpful for filtering across multiple machines if you later federate.
NODE_LABEL=hl-node

# --- Exporter version + flags ----------------------------------------------

# hyperliquid-exporter release to pull from GitHub. Pin to a specific tag
# (e.g. v3.0.0) for reproducible builds, or set to 'latest' to track HEAD.
EXPORTER_VERSION=v3.0.0

# Extra flags passed to `hl_exporter start`. The container always runs with
# --skip-version-check --skip-update-check because the binary lives outside
# the container; remove them only if you bind-mount hl-node into the image.
#
# Useful flags:
#   --replica-metrics          tx/order metrics (needs node --replica-cmds-style)
#   --evm-metrics              HyperEVM gas/tx/account metrics
#   --contract-metrics         per-contract tx tracking
#   --extended-metrics         RocksDB, lz4, tokio, public-IP, logs, etc.
#   --probe-info-endpoint      active probe of node's --serve-info
#   --per-peer-metrics         per-IP last/first-seen (bounded LRU)
EXPORTER_EXTRA_FLAGS="--replica-metrics --evm-metrics"

# --- Grafana / Prometheus ---------------------------------------------------

# Grafana login (you'll be prompted to rotate the password on first login).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Host port for the Grafana UI. Change if 3000 is already taken.
GRAFANA_PORT=3000

# Prometheus on-disk retention. Examples: 15d, 30d, 90d.
PROMETHEUS_RETENTION=30d
